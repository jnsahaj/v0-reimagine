{
  "name": "v0-reimagine",
  "version": "0.1.4",
  "description": "Reimagine an existing web project with v0 from one command.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnsahaj/v0-reimagine.git"
  },
  "homepage": "https://github.com/jnsahaj/v0-reimagine#readme",
  "bugs": "https://github.com/jnsahaj/v0-reimagine/issues",
  "keywords": [
    "v0",
    "vercel",
    "cli",
    "design",
    "ui",
    "website"
  ],
  "bin": {
    "v0-reimagine": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:cli",
    "dev": "tsx src/cli.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepublishOnly": "pnpm check",
    "test": "vitest run",
    "test:cli": "node test/cli-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.2.2",
    "@inquirer/confirm": "^5.1.17",
    "@inquirer/input": "^4.2.1",
    "@inquirer/password": "^4.0.19",
    "@inquirer/select": "^4.3.0",
    "arg": "^5.0.2",
    "chalk": "^5.6.2",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.2",
    "ignore": "^7.0.5",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
